# ---------------------------------------------------------------------------
# Browser (Vite) variables — copy to `.env.local`. These are PUBLIC values.
# Leave Supabase blank to run the whole storefront + admin in local mock mode.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_SITE_URL=http://localhost:5173
# Optional: Firebase phone OTP for checkout (Firebase console → Project settings → Your apps → Web app).
# Needs FIREBASE_PROJECT_ID + SUPABASE_JWT_SECRET on the server (see .dev.vars.example).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_APP_ID=
# Only used in mock mode (no Supabase) to unlock /admin locally.
VITE_ADMIN_DEV_PASSCODE=alankrita-admin
