{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "resolveJsonModule": true,
    "noUnusedLocals": true,
    "types": ["@cloudflare/workers-types"],
    "baseUrl": "..",
    "paths": { "@/*": ["src/*"] }
  },
  "include": [
    "./**/*.ts",
    "../src/lib/jsonld.ts",
    "../src/config/site.ts",
    "../src/config/collections.ts",
    "../src/types/index.ts",
    "../src/data/catalog.json"
  ]
}
